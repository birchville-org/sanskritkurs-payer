{
  "name": "sanskritkurs-pipeline",
  "version": "1.10.3",
  "description": "SSG Pipeline für Sanskritkurs",
  "main": "index.js",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "NODE_OPTIONS=\"--max-old-space-size=32768\" vitepress build docs",
    "postdocs:build": "node scripts/gen_locale_manifests.mjs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky",
    "build:qa-editor": "esbuild scripts/qa-editor/entry.js --bundle --minify --format=iife --outfile=docs/public/qa_editor.js"
  },
  "dependencies": {
    "markdown-it": "^14.2.0",
    "markdown-it-attrs": "^5.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-extensible": "^1.4.2",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@replit/codemirror-vim": "^6.4.0",
    "husky": "^9.1.7",
    "vite": "^8.0.16",
    "vitepress": "^1.6.4"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.1",
    "@rollup/rollup-linux-x64-gnu": "^4.22.4"
  }
}
