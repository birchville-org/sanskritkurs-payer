{
  "name": "sanskritkurs-pipeline",
  "version": "1.9.1",
  "description": "SSG Pipeline für Sanskritkurs",
  "main": "index.js",
  "scripts": {
    "convert": "node scripts/convert.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "NODE_OPTIONS=\"--max-old-space-size=32768\" vitepress build docs",
    "postdocs:build": "node scripts/gen_locale_manifests.mjs",
    "docs:preview": "vitepress preview docs",
    "desktop:prepare": "python3 scripts/prepare_desktop_dist.py",
    "desktop:build": "python3 scripts/prepare_desktop_dist.py && npx tauri build --bundles dmg",
    "prepare": "husky",
    "build:qa-editor": "esbuild scripts/qa-editor/entry.js --bundle --minify --format=iife --outfile=docs/public/qa_editor.js"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.34.0",
    "iconv-lite": "^0.6.3",
    "markdown-it": "^14.2.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-extensible": "^1.4.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@replit/codemirror-vim": "^6.4.0",
    "@tauri-apps/cli": "^2.11.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "markdown-it-attrs": "^5.0.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.60.0",
    "puppeteer": "^25.2.1",
    "vite": "^8.0.16",
    "vitepress": "^1.6.4"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.1",
    "@rollup/rollup-linux-x64-gnu": "^4.22.4"
  }
}
